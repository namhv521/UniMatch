# Copy to .env and set unique local values. .env is ignored by Git.
# Use URL-safe characters for PostgreSQL credentials because Compose builds DATABASE_URL.
POSTGRES_DB=kltn
POSTGRES_USER=kltn
POSTGRES_PASSWORD=

KLTN_LOGIN_EMAIL=
KLTN_LOGIN_PASSWORD=
KLTN_WEB_PORT=8000

# Production HTTPS only. Use a hostname without scheme or path.
KLTN_DOMAIN=

# UniMatch portal. Set these environment variables before launching Python.
# Use the exact origin and register /api/auth/callback/{provider} at each provider.
UNIMATCH_PUBLIC_ORIGIN=http://127.0.0.1:8767
UNIMATCH_GOOGLE_CLIENT_ID=
UNIMATCH_GOOGLE_CLIENT_SECRET=
UNIMATCH_GITHUB_CLIENT_ID=
UNIMATCH_GITHUB_CLIENT_SECRET=
UNIMATCH_FACEBOOK_CLIENT_ID=
UNIMATCH_FACEBOOK_CLIENT_SECRET=
UNIMATCH_AUTH_START_RATE_LIMIT=10
UNIMATCH_AUTH_START_RATE_WINDOW_SECONDS=60
UNIMATCH_TRUST_PROXY_HEADERS=0

# Use stable OAuth subjects for staff. Set the semester to open registration.
UNIMATCH_ROLE_ROSTER={}
UNIMATCH_THESIS_SEMESTER=
# Optional JSON array of pre-provisioned accounts with password/activation hashes.
UNIMATCH_EMAIL_ACCOUNT_SEED=[]

# Thesis Defense Demo Mode (ONLY active when UNIMATCH_DEMO_MODE=1 and UNIMATCH_DEPLOYMENT!=production).
UNIMATCH_DEMO_MODE=0

# Optional LLM API Configuration for Student Profile Academic Normalization & Grounded RAG Synthesis.
# When omitted, UniMatch runs its deterministic Vietnamese Academic Normalizer & Hybrid BM25+E4 RAG Engine offline.
UNIMATCH_LLM_API_KEY=
UNIMATCH_LLM_BASE_URL=
UNIMATCH_LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
UNIMATCH_OPENROUTER_API_KEY=

# Production portal uses a separate unimatch_portal schema in Neon/PostgreSQL.
DATABASE_URL=
UNIMATCH_DATABASE_URL=
UNIMATCH_DEPLOYMENT=local
UNIMATCH_MODEL_BUNDLE=
UNIMATCH_MODEL_BUNDLE_SHA256=
