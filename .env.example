# Copy to .env and set unique local values. .env is ignored by Git.
# Use URL-safe characters for PostgreSQL credentials because Compose builds DATABASE_URL.
POSTGRES_DB=kltn
POSTGRES_USER=kltn
POSTGRES_PASSWORD=

KLTN_LOGIN_EMAIL=
KLTN_LOGIN_PASSWORD=
KLTN_WEB_PORT=8000

# Production HTTPS only. Use a hostname without scheme or path.
KLTN_DOMAIN=

# UniMatch portal. Set these environment variables before launching Python.
# Use the exact origin and register /api/auth/callback/{provider} at each provider.
UNIMATCH_PUBLIC_ORIGIN=http://127.0.0.1:8767
UNIMATCH_GOOGLE_CLIENT_ID=
UNIMATCH_GOOGLE_CLIENT_SECRET=
UNIMATCH_GITHUB_CLIENT_ID=
UNIMATCH_GITHUB_CLIENT_SECRET=
UNIMATCH_FACEBOOK_CLIENT_ID=
UNIMATCH_FACEBOOK_CLIENT_SECRET=
UNIMATCH_AUTH_START_RATE_LIMIT=10
UNIMATCH_AUTH_START_RATE_WINDOW_SECONDS=60

# Production portal uses a separate unimatch_portal schema in Neon/PostgreSQL.
DATABASE_URL=
UNIMATCH_DEPLOYMENT=local
UNIMATCH_MODEL_BUNDLE=
UNIMATCH_MODEL_BUNDLE_SHA256=
